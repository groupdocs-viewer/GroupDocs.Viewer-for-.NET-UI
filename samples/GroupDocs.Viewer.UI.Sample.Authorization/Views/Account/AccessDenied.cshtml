@{
    ViewData["Title"] = "Access denied";
}

<section class="gds-intro">
  <span class="gds-eyebrow">GroupDocs.Viewer.UI sample</span>
  <h1 class="gds-title">Access denied</h1>
  <p class="gds-lead">You are signed in as <b>@User.Identity?.Name</b>, but only users with the <b>@ViewerAccess.Role</b> role can open the viewer. Sign out and sign in as <b>viewer</b>.</p>
  <a asp-controller="Home" asp-action="Index" class="gds-btn gds-btn-outline">Back to the home page</a>
</section>
